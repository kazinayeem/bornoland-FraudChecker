# Optional for local PNG generation. The app auto-detects common Chrome paths.
PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/Google Chrome

# Only needed if you use Vercel Blob for optional PNG storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# Optional: override EliteMart lookup URL
# FRAUD_CHECK_LOOKUP_URL=https://elitemart.com.bd/fraud-check/lookup
