# Optional for local development. The app auto-detects common Chrome paths.
PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/Google Chrome

# Added automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# Optional: override EliteMart lookup URL
# FRAUD_CHECK_LOOKUP_URL=https://elitemart.com.bd/fraud-check/lookup

# Optional: paste Cookie header from a real browser session if Vercel gets Cloudflare 403
# FRAUD_CHECK_COOKIE=cf_clearance=...; other=...
