{
  "name": "bornoland-fraud-checker",
  "version": "1.0.0",
  "description": "JSON-first fraud checker API (optional PNG). Primary: GET /api?number=",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
    "dev": "node --env-file-if-exists=.env.local --watch server.js",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "keywords": [
    "fraud-check",
    "json-api",
    "express",
    "courier"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/blob": "^2.6.1",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "puppeteer-core": "^25.3.0"
  }
}
