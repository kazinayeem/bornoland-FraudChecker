<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Fraud Check Report</title>
<style>
  /* ------------------------------------------------------------------
     Canvas: 540 x 675 CSS px, captured at deviceScaleFactor 2
     => final PNG is 1080 x 1350
  ------------------------------------------------------------------ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-font-smoothing: antialiased;
  }

  html, body {
    width: 540px;
    height: 675px;
    overflow: hidden;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI",
                 Roboto, "Helvetica Neue", Arial, sans-serif;
    background:
      radial-gradient(900px 500px at -10% -20%, #e6ebff 0%, rgba(230, 235, 255, 0) 60%),
      radial-gradient(800px 500px at 110% 120%, #e0f6ec 0%, rgba(224, 246, 236, 0) 55%),
      linear-gradient(160deg, #f6f8fc 0%, #eef1f8 100%);
    padding: 22px;
    color: #0f172a;
    display: flex;
  }

  /* ------------------------------- Card ------------------------------ */
  .card {
    flex: 1;
    min-width: 0; /* never let table content push the card past the viewport */
    background: #ffffff;
    border-radius: 22px;
    box-shadow:
      0 24px 60px rgba(15, 23, 42, 0.10),
      0 4px 14px rgba(15, 23, 42, 0.05);
    padding: 26px 26px 20px;
    display: flex;
    flex-direction: column;
  }

  /* ------------------------------ Header ----------------------------- */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom: 1px solid #eef1f6;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    box-shadow: 0 8px 18px rgba(79, 70, 229, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-icon svg { width: 22px; height: 22px; }

  .brand-title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .brand-sub {
    font-size: 10.5px;
    font-weight: 500;
    color: #64748b;
    margin-top: 2px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .phone-chip {
    display: flex;
    align-items: center;
    gap: 7px;
    background: linear-gradient(135deg, #f1f4ff 0%, #eef2ff 100%);
    border: 1px solid #e0e6ff;
    color: #4338ca;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
    padding: 9px 14px;
    border-radius: 999px;
  }

  .phone-chip svg { width: 14px; height: 14px; }

  /* --------------------------- Summary cards -------------------------- */
  .summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 18px 0;
  }

  .stat {
    border-radius: 15px;
    padding: 13px 12px 12px;
    border: 1px solid;
  }

  .stat-label {
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .stat-value {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.6px;
    margin-top: 6px;
    color: #0f172a;
  }

  .stat-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .stat.orders     { background: linear-gradient(160deg, #f5f7ff, #eef2ff); border-color: #e3e9ff; }
  .stat.orders    .stat-label { color: #4f46e5; }
  .stat.orders    .stat-dot   { background: #6366f1; }

  .stat.delivered  { background: linear-gradient(160deg, #f2fbf7, #e9f9f1); border-color: #d7f0e3; }
  .stat.delivered .stat-label { color: #059669; }
  .stat.delivered .stat-dot   { background: #10b981; }

  .stat.cancelled  { background: linear-gradient(160deg, #fff5f5, #fdeeee); border-color: #f9dcdc; }
  .stat.cancelled .stat-label { color: #dc2626; }
  .stat.cancelled .stat-dot   { background: #ef4444; }

  .stat.rate       { background: linear-gradient(160deg, #fffaf0, #fef5e7); border-color: #f6e7c8; }
  .stat.rate      .stat-label { color: #d97706; }
  .stat.rate      .stat-dot   { background: #f59e0b; }

  /* ------------------------------ Table ------------------------------ */
  .table-wrap {
    border: 1px solid #eef1f6;
    border-radius: 16px;
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed; /* fixed column widths so long badges can't stretch the layout */
  }

  col.col-courier   { width: 38%; }
  col.col-orders    { width: 13%; }
  col.col-delivered { width: 16%; }
  col.col-cancelled { width: 16%; }
  col.col-rate      { width: 17%; }

  thead th {
    background: #f8fafc;
    color: #64748b;
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-align: center;
    padding: 11px 8px;
    border-bottom: 1px solid #eef1f6;
  }

  thead th:first-child { text-align: left; padding-left: 16px; }

  tbody td {
    padding: 12px 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: #334155;
    text-align: center;
    border-bottom: 1px solid #f2f5f9;
  }

  tbody tr:last-child td { border-bottom: none; }

  tbody td:first-child { text-align: left; padding-left: 16px; }

  .courier-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .courier-avatar {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .courier-name {
    font-size: 13.5px;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.2px;
  }

  /* Green rounded rating badge — shown when customer_rating exists */
  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
    max-width: 100%;
    background: linear-gradient(135deg, #ecfdf5, #d9f7e9);
    border: 1px solid #bbebd4;
    color: #047857;
    font-size: 9px;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 999px;
    letter-spacing: 0.2px;
    white-space: nowrap;
  }

  .rating-badge svg { width: 10px; height: 10px; flex-shrink: 0; }

  .num-delivered { color: #059669; }
  .num-cancelled { color: #dc2626; }

  /* Delivery-rate pill with mini progress bar */
  .rate-pill {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-width: 56px;
  }

  .rate-value {
    font-size: 13px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.2px;
  }

  .rate-bar {
    width: 52px;
    height: 5px;
    background: #eef1f6;
    border-radius: 999px;
    overflow: hidden;
  }

  .rate-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #34d399, #10b981);
  }

  .rate-fill.low  { background: linear-gradient(90deg, #f87171, #ef4444); }
  .rate-fill.mid  { background: linear-gradient(90deg, #fbbf24, #f59e0b); }

  /* ------------------------------ Footer ------------------------------ */
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto; /* pins the footer to the bottom of the card */
    padding-top: 14px;
    border-top: 1px solid #eef1f6;
  }

  .verdict {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 999px;
  }

  .verdict.good {
    background: linear-gradient(135deg, #ecfdf5, #d9f7e9);
    border: 1px solid #bbebd4;
    color: #047857;
  }

  .verdict.risky {
    background: linear-gradient(135deg, #fff5f5, #fdeeee);
    border: 1px solid #f9dcdc;
    color: #b91c1c;
  }

  .timestamp {
    font-size: 10px;
    font-weight: 500;
    color: #94a3b8;
    letter-spacing: 0.2px;
  }
</style>
</head>
<body>
<%
  /* --------------------------- Template helpers --------------------------- */

  // Parse "95%" -> 95 (clamped 0..100) for the progress bars
  const ratePercent = (rate) => {
    const n = parseFloat(String(rate).replace('%', ''));
    if (Number.isNaN(n)) return 0;
    return Math.max(0, Math.min(100, n));
  };

  const rateClass = (p) => (p >= 80 ? '' : p >= 50 ? 'mid' : 'low');

  // Deterministic brand-ish avatar colors per courier
  const avatarColors = [
    'linear-gradient(135deg, #f43f5e, #e11d48)',
    'linear-gradient(135deg, #6366f1, #4f46e5)',
    'linear-gradient(135deg, #10b981, #059669)',
    'linear-gradient(135deg, #f59e0b, #d97706)',
    'linear-gradient(135deg, #06b6d4, #0891b2)',
    'linear-gradient(135deg, #8b5cf6, #7c3aed)',
  ];

  const overallRate = ratePercent(report.delivery_rate);
  const isTrusted = overallRate >= 80;

  const generatedAt = new Date().toLocaleString('en-GB', {
    day: '2-digit', month: 'short', year: 'numeric',
    hour: '2-digit', minute: '2-digit',
  });
%>
<div class="card">

  <!-- Header: brand + phone number -->
  <div class="header">
    <div class="brand">
      <div class="brand-icon">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 2.5l7.5 3v5.2c0 4.9-3.2 9.2-7.5 10.8-4.3-1.6-7.5-5.9-7.5-10.8V5.5l7.5-3z" fill="#ffffff" fill-opacity="0.22" stroke="#ffffff" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M8.8 12l2.2 2.2 4.2-4.4" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <div class="brand-title">Fraud Check Report</div>
        <div class="brand-sub">Courier Delivery History</div>
      </div>
    </div>
    <div class="phone-chip">
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="6.5" y="2.5" width="11" height="19" rx="2.5" stroke="#4338ca" stroke-width="1.8"/>
        <circle cx="12" cy="18" r="1.1" fill="#4338ca"/>
      </svg>
      <%= report.phone %>
    </div>
  </div>

  <!-- Summary cards -->
  <div class="summary">
    <div class="stat orders">
      <div class="stat-label"><span class="stat-dot"></span> Orders</div>
      <div class="stat-value"><%= report.total_orders %></div>
    </div>
    <div class="stat delivered">
      <div class="stat-label"><span class="stat-dot"></span> Delivered</div>
      <div class="stat-value"><%= report.total_delivered %></div>
    </div>
    <div class="stat cancelled">
      <div class="stat-label"><span class="stat-dot"></span> Cancelled</div>
      <div class="stat-value"><%= report.total_cancelled %></div>
    </div>
    <div class="stat rate">
      <div class="stat-label"><span class="stat-dot"></span> Rate</div>
      <div class="stat-value"><%= report.delivery_rate %></div>
    </div>
  </div>

  <!-- Courier table -->
  <div class="table-wrap">
    <table>
      <colgroup>
        <col class="col-courier" />
        <col class="col-orders" />
        <col class="col-delivered" />
        <col class="col-cancelled" />
        <col class="col-rate" />
      </colgroup>
      <thead>
        <tr>
          <th>Courier</th>
          <th>Orders</th>
          <th>Delivered</th>
          <th>Cancelled</th>
          <th>Delivery Rate</th>
        </tr>
      </thead>
      <tbody>
        <% report.couriers.forEach((courier, i) => {
             const percent = ratePercent(courier.delivery_rate); %>
        <tr>
          <td>
            <div class="courier-cell">
              <div class="courier-avatar" style="background: <%= avatarColors[i % avatarColors.length] %>;">
                <%= courier.courier_name.charAt(0).toUpperCase() %>
              </div>
              <div>
                <div class="courier-name"><%= courier.courier_name %></div>
                <% if (courier.customer_rating) { %>
                <span class="rating-badge">
                  <svg viewBox="0 0 24 24" fill="#f59e0b">
                    <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.3L12 17.1l-5.7 3.1 1.2-6.3-4.7-4.4 6.4-.8L12 2.8z"/>
                  </svg>
                  <%= courier.customer_rating %>
                </span>
                <% } %>
              </div>
            </div>
          </td>
          <td><%= courier.orders %></td>
          <td class="num-delivered"><%= courier.delivered %></td>
          <td class="num-cancelled"><%= courier.cancelled %></td>
          <td>
            <span class="rate-pill">
              <span class="rate-value"><%= courier.delivery_rate %></span>
              <span class="rate-bar">
                <span class="rate-fill <%= rateClass(percent) %>" style="width: <%= percent %>%; display:block;"></span>
              </span>
            </span>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <!-- Footer: verdict + timestamp -->
  <div class="footer">
    <span class="verdict <%= isTrusted ? 'good' : 'risky' %>">
      <%= isTrusted ? '✓ Trusted Customer' : '⚠ Review Before Shipping' %>
      — <%= report.delivery_rate %> Success
    </span>
    <span class="timestamp">Generated <%= generatedAt %></span>
  </div>

</div>
</body>
</html>
